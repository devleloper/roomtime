<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device transfer of app data. Secure
     storage (guest id, owner tokens) is encrypted with a Keystore key that
     never leaves the device, so a copy could not be decrypted anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
